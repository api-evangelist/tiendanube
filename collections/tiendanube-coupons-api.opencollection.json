{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tiendanube / Nuvemshop Categories Coupons API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authentication",
      "value": "{{Authentication}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Coupons",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List coupons",
            "type": "http"
          },
          "http": {
            "method": "GET",
