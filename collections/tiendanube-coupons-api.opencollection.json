          },
          "http": {
            "method": "POST",
            "url": "https://api.tiendanube.com/v1/{store_id}/coupons",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a coupon"
        },
        {
          "info": {
            "name": "Delete a coupon",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tiendanube.com/v1/{store_id}/coupons/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a coupon"
        }
      ]
    }
  ],
  "bundled": true
}