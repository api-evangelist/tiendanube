{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tiendanube / Nuvemshop Categories Orders API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authentication",
      "value": "{{Authentication}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tiendanube.com/v1/{store_id}/orders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "payment_status",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_at_min",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List orders"
        },
        {
          "info": {
            "name": "Get an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tiendanube.com/v1/{store_id}/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an order"
        },
        {
          "info": {
            "name": "Close an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tiendanube.com/v1/{store_id}/orders/:id/close",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Close an order"
        },
        {
          "info": {
            "name": "Cancel an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tiendanube.com/v1/{store_id}/orders/:id/cancel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel an order"
        }
      ]
    }
  ],
  "bundled": true
}